package utilsrel

import "github.com/felixlinker/keytrans-verification/pkg/utils"

// ##(--hyperMode extended)

// Lemma: returns a low sequence equal to GetBytesContent(data).
// As Gobra currently does not support hyper functions, this
// lemma is used to show that GetBytesContent returns a low sequence if
// the content of the byte slice is low.
ghost
requires noPerm < p
preserves acc(utils.BytesMem(s), p)
ensures   result == utils.GetBytesContent(s)
// NOTE: Wanted to use == below instead of two ==> but get a permission error in that case
ensures   (low(len(s)) && unfolding acc(utils.BytesMem(s), p) in forall i int :: { s[i] } 0 <= i && i < len(s) ==> low(s[i])) ==> low(result)
ensures   low(result) ==> (low(len(s)) && unfolding acc(utils.BytesMem(s), p) in forall i int :: { s[i] } 0 <= i && i < len(s) ==> low(s[i]))
decreases
func GetBytesContentIsLow(s []byte, ghost p perm) (result seq[byte]) {
  unfold acc(utils.BytesMem(s), p)
  result = getByteContentIsLow(s, 0, p/2)
  fold acc(utils.BytesMem(s), p)
  assert result == reveal utils.GetBytesContent(s)
}

ghost
requires noPerm < p
requires acc(data, p)
requires 0 <= idx && idx <= len(data)
ensures  acc(data, p)
ensures  result == utils.getBytesContent_Rec(data, idx)
ensures  low(idx) ==> ((low(len(data)) && forall i int :: { data[i] } idx <= i && i < len(data) ==> low(data[i])) == low(result))
decreases len(data) - idx
func getByteContentIsLow(data []byte, idx int, ghost p perm) (result seq[byte]) {
  if idx == len(data) {
    result = seq[byte]{}
  } else {
    tail := getByteContentIsLow(data, idx + 1, p/2)
    result = seq[byte]{data[idx]} ++ tail
    assert forall i int :: {tail[i]} 0 <= i && i < len(tail) ==> result[i+1] == tail[i]
  }
}
