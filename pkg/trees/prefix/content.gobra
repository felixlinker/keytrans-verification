// Pure model of a prefix tree's hashed content.
//
// Content() projects a *Tree onto a TreeContent and RootHashOf computes its
// root hash, mirroring Tree.value(). Reasoning then happens over pure
// functions: lowness propagates through RootHashOf without proof, and the
// converse is an induction over the ADT under a no-collision hypothesis,
// rather than a relational argument over a permission-carrying structure.
//
package prefix

import (
	"crypto/sha256"
	"github.com/felixlinker/keytrans-verification/pkg/crypto"
	"github.com/felixlinker/keytrans-verification/pkg/utils"
)

// Carries exactly what the root hash depends on.
ghost type TreeContent adt {
	emptyTree{}

	opaqueLeaf{
		hash seq[byte]
	}

	keyLeaf{
		searchKey  seq[byte]
		commitment seq[byte]
	}

	innerNode{
		left  TreeContent
		right TreeContent
	}
}

ghost
requires 0 <= n
ensures  len(r) == n
ensures  forall i int :: {r[i]} 0 <= i && i < n ==> r[i] == byte(0)
decreases n
pure func zeroBytes(n int) (r seq[byte]) {
	return n == 0 ? seq[byte]{} : zeroBytes(n-1) ++ seq[byte]{ byte(0) }
}

// The value of an absent subtree: sha256.Size zero bytes, as returned by
// Tree.value() for a nil receiver.
ghost
ensures len(r) == sha256.Size
ensures forall i int :: {r[i]} 0 <= i && i < len(r) ==> r[i] == byte(0)
decreases
pure func ZeroHash() (r seq[byte]) {
	return zeroBytes(sha256.Size)
}

// Domain separation tags, matching the byte literals in Tree.value().
ghost
decreases
pure func leafTag() seq[byte] { return seq[byte]{ byte(0x02) } }

ghost
decreases
pure func innerTag() seq[byte] { return seq[byte]{ byte(0x03) } }

// Mirrors Tree.value().
ghost
decreases len(c)
pure func RootHashOf(c TreeContent) seq[byte] {
	return match c {
		case emptyTree{}:
			ZeroHash()
		case opaqueLeaf{?h}:
			h
		case keyLeaf{?sk, ?cm}:
			crypto.HashOf(leafTag() ++ sk ++ cm)
		case innerNode{?l, ?r}:
			crypto.HashOf(innerTag() ++ RootHashOf(l) ++ RootHashOf(r))
	}
}

// Inv() guarantees exactly one of value / (searchKey, commitment) is set.
ghost
requires l != nil ==> acc(l.Inv(), _)
decreases
pure func (l *prefixLeaf) Content() (r TreeContent) {
	return l == nil ? emptyTree{} :
		unfolding acc(l.Inv(), _) in
			l.value != nil ?
				opaqueLeaf{ utils.GetBytesContent(l.value) } :
				keyLeaf{ utils.GetBytesContent(l.searchKey),
					utils.GetBytesContent(l.commitment) }
}

ghost
requires  t != nil ==> acc(t.Inv(), _)
decreases acc(t.Inv(), _)
pure func (t *Tree) Content() (r TreeContent) {
	return t == nil ? emptyTree{} :
		unfolding acc(t.Inv(), _) in
			t.leaf != nil ?
				t.leaf.Content() :
				innerNode{
					// Nil children are guarded because the termination measure
					// acc(t.Inv(), _) cannot be evaluated for a nil receiver.
					t.left == nil ? emptyTree{} : t.left.Content(),
					t.right == nil ? emptyTree{} : t.right.Content() }
}
